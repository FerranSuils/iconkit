<?xml version="1.0" encoding="UTF-8"?>
<!--
  IconKit CDN (iconkit.suils.es) — sirve dist/ como assets estáticos públicos.
  CORS abierto (solo lectura de assets estáticos), caché larga y MIME correctos.
-->
<configuration>
  <system.webServer>
    <staticContent>
      <remove fileExtension=".wasm" />
      <mimeMap fileExtension=".wasm" mimeType="application/wasm" />
      <remove fileExtension=".mjs" />
      <mimeMap fileExtension=".mjs" mimeType="text/javascript" />
      <remove fileExtension=".json" />
      <mimeMap fileExtension=".json" mimeType="application/json" />
      <remove fileExtension=".svg" />
      <mimeMap fileExtension=".svg" mimeType="image/svg+xml" />
      <remove fileExtension=".webmanifest" />
      <mimeMap fileExtension=".webmanifest" mimeType="application/manifest+json" />
      <!-- Código fuente de los paquetes: servirlo como texto descargable (no ejecutar) -->
      <remove fileExtension=".dart" /><mimeMap fileExtension=".dart" mimeType="text/plain" />
      <remove fileExtension=".kt" /><mimeMap fileExtension=".kt" mimeType="text/plain" />
      <remove fileExtension=".kts" /><mimeMap fileExtension=".kts" mimeType="text/plain" />
      <remove fileExtension=".swift" /><mimeMap fileExtension=".swift" mimeType="text/plain" />
      <remove fileExtension=".py" /><mimeMap fileExtension=".py" mimeType="text/plain" />
      <remove fileExtension=".php" /><mimeMap fileExtension=".php" mimeType="text/plain" />
      <remove fileExtension=".cs" /><mimeMap fileExtension=".cs" mimeType="text/plain" />
      <remove fileExtension=".razor" /><mimeMap fileExtension=".razor" mimeType="text/plain" />
      <remove fileExtension=".vue" /><mimeMap fileExtension=".vue" mimeType="text/plain" />
      <remove fileExtension=".svelte" /><mimeMap fileExtension=".svelte" mimeType="text/plain" />
      <remove fileExtension=".ts" /><mimeMap fileExtension=".ts" mimeType="text/plain" />
      <remove fileExtension=".tsx" /><mimeMap fileExtension=".tsx" mimeType="text/plain" />
      <remove fileExtension=".md" /><mimeMap fileExtension=".md" mimeType="text/markdown" />
      <remove fileExtension=".yaml" /><mimeMap fileExtension=".yaml" mimeType="text/plain" />
      <remove fileExtension=".yml" /><mimeMap fileExtension=".yml" mimeType="text/plain" />
      <remove fileExtension=".toml" /><mimeMap fileExtension=".toml" mimeType="text/plain" />
      <!-- Caché larga para assets (los ficheros versionan por contenido/tag) -->
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="7.00:00:00" />
    </staticContent>
    <httpProtocol>
      <customHeaders>
        <!-- CDN público de solo lectura: permite el consumo cross-origin -->
        <add name="Access-Control-Allow-Origin" value="*" />
        <add name="Access-Control-Allow-Methods" value="GET, OPTIONS" />
        <add name="Access-Control-Allow-Headers" value="Content-Type" />
        <add name="X-Content-Type-Options" value="nosniff" />
      </customHeaders>
    </httpProtocol>
    <defaultDocument>
      <files>
        <clear />
        <add value="index.html" />
      </files>
    </defaultDocument>
    <!-- Nota: IIS bloquea por seguridad servir .cs/.razor como estáticos; los
         consumidores .NET usan el paquete NuGet, no la descarga HTTP directa. -->
  </system.webServer>
  <!-- index.html: revalidar siempre (no-cache) para que el reinicio semanal del
       token ?c del CSS llegue al instante; el servidor devuelve 304 si no cambió
       (respuesta minúscula), así que sigue siendo rápido y nunca se queda stale. -->
  <location path="index.html">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="DisableCache" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
